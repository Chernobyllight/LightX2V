{
    "infer_steps": 1,
    "sample_guide_scale": 5.0,
    "flow_shift": 1.0,
    "target_height": 1024,
    "target_width": 1024,
    "feature_caching": "NoCaching",
    "moe_impl": "flashinfer",
    "attn_impl": "torch_sdpa",
    "flashinfer_autotune_mode": "off",
    "flashinfer_tune_max_num_tokens": 16384,
    "enable_kv_cache": true,
    "enable_text_kv_cache": true,
    "use_taylor_cache": false,
    "parallel": {
        "pipeline_parallel": false,
        "phase_aware": true,
        "storage_tensor_p_size": 2,
        "ar": {
            "tensor_p_size": 4,
            "seq_p_size": 1
        },
        "denoise": {
            "tensor_p_size": 2,
            "seq_p_size": 2
        },
        "cfg_p_size": 1,
        "seq_p_attn_type": "ulysses",
        "cfg_mode": "serial"
    },
    "enable_cfg": true,
    "bot_task": "recaption",
    "use_system_prompt": "en_unified",
    "max_new_tokens": 4,
    "text_do_sample": false,
    "text_stream_output": false,
    "disable_progress_bar": true
}
